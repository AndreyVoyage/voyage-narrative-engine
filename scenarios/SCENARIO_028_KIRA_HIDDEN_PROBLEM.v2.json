              "beat_id": "1A-b6",
              "type": "action",
              "speaker": "kira",
              "pov": "kira",
              "speech": null,
              "action": "Кира медленно выпрямляется и убирает руку со стола на колени, сцепляя пальцы в замок — не от злости, а чтобы не потянуться к нему.",
              "thought": null,
              "thought_visibility": null,
              "narration": null,
              "emotion": "U3-A",
              "visual_cue": null
            },
            {
