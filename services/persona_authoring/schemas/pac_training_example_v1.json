{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pac-training-example-v1",
  "title": "PAC Training Example v1",
  "description": "Schema for training_dataset.jsonl records per N9 PAC v0.",
  "type": "object",
  "required": [
    "schema_version",
    "example_id",
    "created_at",
    "character_id",
    "authoring_session_id",
    "provider",
    "model",
    "canon_snapshot",
    "context",
    "model_output_raw",
    "approved_output",
    "provenance",
    "quality_status",
    "edit_metrics",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["pac-training-example-v1"]
    },
    "example_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": ["string", "null"]
    },
    "authoring_session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "provider": {
      "type": "string",
      "enum": ["local", "cloud", "mock"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "canon_snapshot": {
      "type": "object",
      "required": ["source_commit", "modules"],
      "properties": {
        "source_commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["module_id", "content_hash", "provenance"],
            "properties": {
              "module_id": { "type": "string", "minLength": 1 },
              "content_hash": { "type": "string", "minLength": 1 },
              "provenance": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["level", "situation", "author_instruction", "fmdr_required"],
      "properties": {
        "level": { "type": "string", "minLength": 1 },
        "situation": { "type": "string", "minLength": 1 },
        "author_instruction": { "type": "string", "minLength": 1 },
        "fmdr_required": { "type": "boolean" }
      }
    },
    "model_output_raw": {
      "type": "string",
      "minLength": 1
    },
    "approved_output": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "enum": ["human-written", "human-edited", "model-raw-approved"]
    },
    "quality_status": {
      "type": "string",
      "enum": ["approved"]
    },
    "edit_metrics": {
      "type": "object",
      "required": ["was_edited"],
      "properties": {
        "was_edited": { "type": "boolean" }
      }
    },
    "gates": {
      "type": "object",
      "required": ["fmdr_valid", "speech_uniqueness_pass", "canon_reviewed_by_human"],
      "properties": {
        "fmdr_valid": { "type": "boolean" },
        "speech_uniqueness_pass": { "type": "boolean" },
        "canon_reviewed_by_human": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": false
}