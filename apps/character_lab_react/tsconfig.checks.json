{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "outDir": "dist-checks",
    "rootDir": "."
  },
  "include": [
    "scripts/structural-checks.ts",
    "scripts/evolution-checks.ts",
    "src/client/types.ts",
    "src/client/characterClient.ts",
    "src/client/characterDebugClient.ts",
    "src/client/httpCharacterClient.ts",
    "src/mocks/mockData.ts",
    "src/mocks/mockCharacterClient.ts",
    "src/mocks/mockCharacterDebugClient.ts",
    "src/features/state/stateInput.ts"
  ]
}
