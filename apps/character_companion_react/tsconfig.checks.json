{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "outDir": "dist-checks",
    "rootDir": "."
  },
  "include": [
    "scripts/structural-checks.ts",
    "src/client/types.ts",
    "src/client/httpCompanionClient.ts",
    "src/mocks/mockCompanionClient.ts",
    "src/app/companionState.ts"
  ]
}
