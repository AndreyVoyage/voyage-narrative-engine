{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "outDir": "dist-checks",
    "rootDir": "."
  },
  "include": [
    "scripts/node-min.d.ts",
    "scripts/structural-checks.ts",
    "src/client/types.ts",
    "src/client/httpCompanionClient.ts",
    "src/mocks/mockCompanionClient.ts",
    "src/app/companionState.ts",
    "src/app/appearance.ts",
    "src/app/newDialog.ts",
    "src/app/settingsState.ts",
    "src/app/userProfile.ts",
    "src/app/focusBackground.ts",
    "src/app/focusGallery.ts",
    "src/app/composerAssistant.ts",
    "src/assets/portraitPlaceholder.ts",
    "src/assets/portrait.ts",
    "src/i18n/index.ts",
    "src/i18n/ru.ts",
    "src/i18n/en.ts",
    "src/i18n/es.ts",
    "src/i18n/zhCN.ts",
    "src/i18n/pt.ts"
  ]
}
